{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff Check revisioned constraint manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "constraints"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "description": "IDs must be unique. Replacement references must exist, share scope, and form an acyclic graph; these checks are enforced by the CLI."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "UTC only; real calendar dates required. The CLI also rejects leap seconds and rollover dates."
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "description", "source", "revision"],
      "dependentRequired": {
        "replacedBy": ["supersededAt"],
        "supersededAt": ["replacedBy"]
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "scope": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/text"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "revokedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "replacedBy": {
          "$ref": "#/$defs/identifier"
        },
        "supersededAt": {
          "$ref": "#/$defs/timestamp"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
