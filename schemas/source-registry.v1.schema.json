{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://github.com/Larusajs/Handoff-Check/schemas/source-registry.v1.schema.json",
  "title": "Handoff Check local source registry v1",
  "required": ["schemaVersion", "capturedAt", "sources"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "$ref": "#/$defs/identifier"
    },
    "capturedAt": {
      "$ref": "#/$defs/utc"
    },
    "sources": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "revision", "contentHash", "fileHash"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          },
          "path": {
            "$ref": "#/$defs/sourcePath"
          },
          "fileHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Portable relative POSIX file path. Runtime additionally validates components/reserved names/containment and rejects symlinks."
    }
  }
}
