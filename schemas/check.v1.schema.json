{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Larusajs/Handoff-Check/schemas/check.v1.schema.json",
  "title": "Handoff Check combined check v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "scope",
    "asOf",
    "activeConstraintCount",
    "policy",
    "checks",
    "summary",
    "notice"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "combined-check"
    },
    "status": {
      "enum": ["passed", "attention", "invalid"]
    },
    "scope": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "activeConstraintCount": {
      "type": "integer",
      "minimum": 0
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireContent", "requireActive"],
      "properties": {
        "requireContent": {
          "const": true
        },
        "requireActive": {
          "const": true
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification", "review", "sources"],
      "properties": {
        "verification": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "result"],
              "properties": {
                "status": {
                  "enum": ["passed", "attention"]
                },
                "result": {
                  "$ref": "#/$defs/verification"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "passed"
                      }
                    },
                    "type": "object"
                  },
                  "then": {
                    "properties": {
                      "result": {
                        "properties": {
                          "status": {
                            "const": "verified"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "else": {
                    "properties": {
                      "result": {
                        "properties": {
                          "status": {
                            "const": "mismatch"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                }
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "error"],
              "properties": {
                "status": {
                  "const": "invalid"
                },
                "error": {
                  "type": "string",
                  "maxLength": 512
                }
              }
            }
          ]
        },
        "review": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "result"],
              "properties": {
                "status": {
                  "enum": ["passed", "attention"]
                },
                "result": {
                  "$ref": "#/$defs/review"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "passed"
                      }
                    },
                    "type": "object"
                  },
                  "then": {
                    "properties": {
                      "result": {
                        "properties": {
                          "status": {
                            "const": "current"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "else": {
                    "properties": {
                      "result": {
                        "properties": {
                          "status": {
                            "const": "attention"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                }
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "error"],
              "properties": {
                "status": {
                  "const": "invalid"
                },
                "error": {
                  "type": "string",
                  "maxLength": 512
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": {
                  "const": "not-requested"
                }
              }
            }
          ]
        },
        "sources": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "result"],
              "properties": {
                "status": {
                  "enum": ["passed", "attention"]
                },
                "result": {
                  "$ref": "#/$defs/sources"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "passed"
                      }
                    },
                    "type": "object"
                  },
                  "then": {
                    "properties": {
                      "result": {
                        "properties": {
                          "status": {
                            "const": "unchanged"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "else": {
                    "properties": {
                      "result": {
                        "properties": {
                          "status": {
                            "const": "attention"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                }
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "error"],
              "properties": {
                "status": {
                  "const": "invalid"
                },
                "error": {
                  "type": "string",
                  "maxLength": 512
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": {
                  "const": "not-requested"
                }
              }
            }
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedChecks",
        "passedChecks",
        "attentionChecks",
        "invalidChecks",
        "notRequestedChecks"
      ],
      "properties": {
        "requestedChecks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "passedChecks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "attentionChecks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "invalidChecks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "notRequestedChecks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "notice": {
      "type": "string"
    }
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "tracking",
        "activeConstraintCount",
        "status",
        "scope",
        "asOf",
        "expectedConstraints",
        "reportedConstraints",
        "findings"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [2, 3, 4]
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "tracking": {
          "const": "content"
        },
        "activeConstraintCount": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": ["verified", "mismatch"]
        },
        "scope": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "expectedConstraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          }
        },
        "reportedConstraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message"],
                "properties": {
                  "code": {
                    "const": "NO_ACTIVE_CONSTRAINTS"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "id", "message"],
                "properties": {
                  "code": {
                    "enum": [
                      "MISSING",
                      "EXPIRED",
                      "REVOKED",
                      "SUPERSEDED",
                      "OUT_OF_SCOPE",
                      "UNKNOWN"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "id", "message", "expected", "reported"],
                "properties": {
                  "code": {
                    "const": "CHANGED"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
                  },
                  "message": {
                    "type": "string"
                  },
                  "expected": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["revision", "contentHash"],
                    "properties": {
                      "revision": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "contentHash": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                      }
                    }
                  },
                  "reported": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["revision", "contentHash"],
                    "properties": {
                      "revision": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "contentHash": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                      }
                    }
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["field", "before", "after"],
                          "properties": {
                            "field": {
                              "const": "revision"
                            },
                            "before": {
                              "type": ["integer", "null"],
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "after": {
                              "type": ["integer", "null"],
                              "minimum": 1,
                              "maximum": 9007199254740991
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["field", "before", "after"],
                          "properties": {
                            "field": {
                              "enum": [
                                "id",
                                "scope",
                                "description",
                                "source",
                                "expiresAt",
                                "revokedAt",
                                "replacedBy",
                                "supersededAt"
                              ]
                            },
                            "before": {
                              "type": ["string", "null"]
                            },
                            "after": {
                              "type": ["string", "null"]
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "findings": {
                "maxItems": 0,
                "type": "array"
              },
              "activeConstraintCount": {
                "minimum": 1,
                "type": "integer"
              },
              "expectedConstraints": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "findings": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": 4
              }
            },
            "type": "object"
          },
          "then": {
            "required": ["projectId"],
            "type": "object"
          }
        }
      ]
    },
    "review": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/Larusajs/Handoff-Check/schemas/review-result.v1.schema.json",
      "title": "Handoff Check rule review result v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "status",
        "scope",
        "asOf",
        "activeConstraintCount",
        "currentReviewCount",
        "registryEntryCount",
        "ignoredEntryCount",
        "rules",
        "findings",
        "notice"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "rule-review"
        },
        "status": {
          "enum": ["current", "attention"]
        },
        "scope": {
          "$ref": "#/$defs/identifier"
        },
        "asOf": {
          "$ref": "#/$defs/utc"
        },
        "projectId": {
          "$ref": "#/$defs/identifier"
        },
        "activeConstraintCount": {
          "type": "integer",
          "minimum": 0
        },
        "currentReviewCount": {
          "type": "integer",
          "minimum": 0
        },
        "registryEntryCount": {
          "type": "integer",
          "minimum": 0
        },
        "ignoredEntryCount": {
          "type": "integer",
          "minimum": 0
        },
        "notice": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "expected"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "status": {
                "enum": [
                  "CURRENT",
                  "MISSING_REVIEW",
                  "STALE_REVIEW",
                  "FUTURE_REVIEW",
                  "OVERDUE_REVIEW"
                ]
              },
              "expected": {
                "$ref": "#/$defs/reference"
              },
              "recorded": {
                "$ref": "#/$defs/reference"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reviewedAt": {
                "$ref": "#/$defs/utc"
              },
              "reviewBy": {
                "$ref": "#/$defs/utc"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "MISSING_REVIEW"
                    }
                  },
                  "type": "object"
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": ["recorded"],
                        "type": "object"
                      },
                      {
                        "required": ["owner"],
                        "type": "object"
                      },
                      {
                        "required": ["reviewedAt"],
                        "type": "object"
                      },
                      {
                        "required": ["reviewBy"],
                        "type": "object"
                      }
                    ]
                  }
                },
                "else": {
                  "required": ["recorded", "owner", "reviewedAt", "reviewBy"],
                  "type": "object"
                }
              }
            ]
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "enum": [
                  "MISSING_REVIEW",
                  "STALE_REVIEW",
                  "FUTURE_REVIEW",
                  "OVERDUE_REVIEW",
                  "UNKNOWN_RULE",
                  "NO_ACTIVE_CONSTRAINTS"
                ]
              },
              "id": {
                "$ref": "#/$defs/identifier"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "code": {
                      "const": "NO_ACTIVE_CONSTRAINTS"
                    }
                  },
                  "type": "object"
                },
                "then": {
                  "not": {
                    "required": ["id"],
                    "type": "object"
                  }
                },
                "else": {
                  "required": ["id"],
                  "type": "object"
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "current"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "findings": {
                "maxItems": 0,
                "type": "array"
              },
              "activeConstraintCount": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "findings": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          }
        }
      ],
      "$defs": {
        "identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision", "contentHash"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "contentHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
            }
          }
        }
      }
    },
    "sources": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "$id": "https://github.com/Larusajs/Handoff-Check/schemas/source-result.v1.schema.json",
      "title": "Handoff Check local source check result v1",
      "required": [
        "schemaVersion",
        "kind",
        "status",
        "scope",
        "asOf",
        "activeConstraintCount",
        "unchangedSourceCount",
        "registryEntryCount",
        "ignoredEntryCount",
        "rules",
        "findings",
        "notice"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "source-check"
        },
        "status": {
          "enum": ["unchanged", "attention"]
        },
        "scope": {
          "$ref": "#/$defs/identifier"
        },
        "asOf": {
          "$ref": "#/$defs/utc"
        },
        "projectId": {
          "$ref": "#/$defs/identifier"
        },
        "activeConstraintCount": {
          "type": "integer",
          "minimum": 0
        },
        "unchangedSourceCount": {
          "type": "integer",
          "minimum": 0
        },
        "registryEntryCount": {
          "type": "integer",
          "minimum": 0
        },
        "ignoredEntryCount": {
          "type": "integer",
          "minimum": 0
        },
        "notice": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "expected"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "status": {
                "enum": [
                  "UNCHANGED",
                  "SOURCE_CHANGED",
                  "MISSING_BINDING",
                  "STALE_BINDING",
                  "SOURCE_MISSING",
                  "SOURCE_UNREADABLE",
                  "SOURCE_UNSAFE",
                  "SOURCE_TOO_LARGE"
                ]
              },
              "expected": {
                "$ref": "#/$defs/reference"
              },
              "recorded": {
                "$ref": "#/$defs/reference"
              },
              "path": {
                "$ref": "#/$defs/sourcePath"
              },
              "expectedFileHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
              },
              "observedFileHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
              },
              "observedBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10485760
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "MISSING_BINDING"
                    }
                  },
                  "type": "object"
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": ["recorded"],
                        "type": "object"
                      },
                      {
                        "required": ["path"],
                        "type": "object"
                      },
                      {
                        "required": ["expectedFileHash"],
                        "type": "object"
                      },
                      {
                        "required": ["observedFileHash"],
                        "type": "object"
                      },
                      {
                        "required": ["observedBytes"],
                        "type": "object"
                      }
                    ]
                  }
                },
                "else": {
                  "required": ["recorded", "path", "expectedFileHash"],
                  "type": "object"
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": ["UNCHANGED", "SOURCE_CHANGED"]
                    }
                  },
                  "type": "object"
                },
                "then": {
                  "required": ["observedFileHash", "observedBytes"],
                  "type": "object"
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": ["observedFileHash"],
                        "type": "object"
                      },
                      {
                        "required": ["observedBytes"],
                        "type": "object"
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "enum": [
                  "SOURCE_CHANGED",
                  "MISSING_BINDING",
                  "STALE_BINDING",
                  "SOURCE_MISSING",
                  "SOURCE_UNREADABLE",
                  "SOURCE_UNSAFE",
                  "SOURCE_TOO_LARGE",
                  "UNKNOWN_RULE",
                  "NO_ACTIVE_CONSTRAINTS"
                ]
              },
              "id": {
                "$ref": "#/$defs/identifier"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "code": {
                      "const": "NO_ACTIVE_CONSTRAINTS"
                    }
                  },
                  "type": "object"
                },
                "then": {
                  "not": {
                    "required": ["id"],
                    "type": "object"
                  }
                },
                "else": {
                  "required": ["id"],
                  "type": "object"
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unchanged"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "findings": {
                "type": "array",
                "maxItems": 0
              },
              "activeConstraintCount": {
                "type": "integer",
                "minimum": 1
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "findings": {
                "type": "array",
                "minItems": 1
              }
            },
            "type": "object"
          }
        }
      ],
      "$defs": {
        "identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Portable relative POSIX file path. Runtime additionally validates components/reserved names/containment and rejects symlinks."
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision", "contentHash"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "contentHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
            }
          }
        }
      }
    }
  }
}
