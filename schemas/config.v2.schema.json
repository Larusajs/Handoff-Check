{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff Check explicit project/profile config v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "constraints": {
      "type": "string",
      "pattern": "\\S"
    },
    "handoff": {
      "type": "string",
      "pattern": "\\S"
    },
    "scope": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope"],
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "constraints": {
            "type": "string",
            "pattern": "\\S"
          },
          "handoff": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
