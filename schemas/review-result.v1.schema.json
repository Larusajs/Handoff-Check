{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Larusajs/Handoff-Check/schemas/review-result.v1.schema.json",
  "title": "Handoff Check rule review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "scope",
    "asOf",
    "activeConstraintCount",
    "currentReviewCount",
    "registryEntryCount",
    "ignoredEntryCount",
    "rules",
    "findings",
    "notice"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "rule-review"
    },
    "status": {
      "enum": ["current", "attention"]
    },
    "scope": {
      "$ref": "#/$defs/identifier"
    },
    "asOf": {
      "$ref": "#/$defs/utc"
    },
    "projectId": {
      "$ref": "#/$defs/identifier"
    },
    "activeConstraintCount": {
      "type": "integer",
      "minimum": 0
    },
    "currentReviewCount": {
      "type": "integer",
      "minimum": 0
    },
    "registryEntryCount": {
      "type": "integer",
      "minimum": 0
    },
    "ignoredEntryCount": {
      "type": "integer",
      "minimum": 0
    },
    "notice": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "expected"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "status": {
            "enum": [
              "CURRENT",
              "MISSING_REVIEW",
              "STALE_REVIEW",
              "FUTURE_REVIEW",
              "OVERDUE_REVIEW"
            ]
          },
          "expected": {
            "$ref": "#/$defs/reference"
          },
          "recorded": {
            "$ref": "#/$defs/reference"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewedAt": {
            "$ref": "#/$defs/utc"
          },
          "reviewBy": {
            "$ref": "#/$defs/utc"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "MISSING_REVIEW"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": ["recorded"]
                  },
                  {
                    "required": ["owner"]
                  },
                  {
                    "required": ["reviewedAt"]
                  },
                  {
                    "required": ["reviewBy"]
                  }
                ]
              }
            },
            "else": {
              "required": ["recorded", "owner", "reviewedAt", "reviewBy"]
            }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {
            "enum": [
              "MISSING_REVIEW",
              "STALE_REVIEW",
              "FUTURE_REVIEW",
              "OVERDUE_REVIEW",
              "UNKNOWN_RULE",
              "NO_ACTIVE_CONSTRAINTS"
            ]
          },
          "id": {
            "$ref": "#/$defs/identifier"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "code": {
                  "const": "NO_ACTIVE_CONSTRAINTS"
                }
              }
            },
            "then": {
              "not": {
                "required": ["id"]
              }
            },
            "else": {
              "required": ["id"]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "current"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0,
            "type": "array"
          },
          "activeConstraintCount": {
            "minimum": 1,
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "contentHash"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    }
  }
}
