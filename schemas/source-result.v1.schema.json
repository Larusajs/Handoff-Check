{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://github.com/Larusajs/Handoff-Check/schemas/source-result.v1.schema.json",
  "title": "Handoff Check local source check result v1",
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "scope",
    "asOf",
    "activeConstraintCount",
    "unchangedSourceCount",
    "registryEntryCount",
    "ignoredEntryCount",
    "rules",
    "findings",
    "notice"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "source-check"
    },
    "status": {
      "enum": ["unchanged", "attention"]
    },
    "scope": {
      "$ref": "#/$defs/identifier"
    },
    "asOf": {
      "$ref": "#/$defs/utc"
    },
    "projectId": {
      "$ref": "#/$defs/identifier"
    },
    "activeConstraintCount": {
      "type": "integer",
      "minimum": 0
    },
    "unchangedSourceCount": {
      "type": "integer",
      "minimum": 0
    },
    "registryEntryCount": {
      "type": "integer",
      "minimum": 0
    },
    "ignoredEntryCount": {
      "type": "integer",
      "minimum": 0
    },
    "notice": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "expected"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "status": {
            "enum": [
              "UNCHANGED",
              "SOURCE_CHANGED",
              "MISSING_BINDING",
              "STALE_BINDING",
              "SOURCE_MISSING",
              "SOURCE_UNREADABLE",
              "SOURCE_UNSAFE",
              "SOURCE_TOO_LARGE"
            ]
          },
          "expected": {
            "$ref": "#/$defs/reference"
          },
          "recorded": {
            "$ref": "#/$defs/reference"
          },
          "path": {
            "$ref": "#/$defs/sourcePath"
          },
          "expectedFileHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          },
          "observedFileHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          },
          "observedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10485760
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "MISSING_BINDING"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": ["recorded"]
                  },
                  {
                    "required": ["path"]
                  },
                  {
                    "required": ["expectedFileHash"]
                  },
                  {
                    "required": ["observedFileHash"]
                  },
                  {
                    "required": ["observedBytes"]
                  }
                ]
              }
            },
            "else": {
              "required": ["recorded", "path", "expectedFileHash"]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["UNCHANGED", "SOURCE_CHANGED"]
                }
              }
            },
            "then": {
              "required": ["observedFileHash", "observedBytes"]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": ["observedFileHash"]
                  },
                  {
                    "required": ["observedBytes"]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {
            "enum": [
              "SOURCE_CHANGED",
              "MISSING_BINDING",
              "STALE_BINDING",
              "SOURCE_MISSING",
              "SOURCE_UNREADABLE",
              "SOURCE_UNSAFE",
              "SOURCE_TOO_LARGE",
              "UNKNOWN_RULE",
              "NO_ACTIVE_CONSTRAINTS"
            ]
          },
          "id": {
            "$ref": "#/$defs/identifier"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "code": {
                  "const": "NO_ACTIVE_CONSTRAINTS"
                }
              }
            },
            "then": {
              "not": {
                "required": ["id"]
              }
            },
            "else": {
              "required": ["id"]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "unchanged"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "type": "array",
            "maxItems": 0
          },
          "activeConstraintCount": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Portable relative POSIX file path. Runtime additionally validates components/reserved names/containment and rejects symlinks."
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "contentHash"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    }
  }
}
