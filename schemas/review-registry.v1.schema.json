{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Larusajs/Handoff-Check/schemas/review-registry.v1.schema.json",
  "title": "Handoff Check review registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "$ref": "#/$defs/identifier"
    },
    "rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "contentHash",
          "owner",
          "reviewedAt",
          "reviewBy"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewedAt": {
            "$ref": "#/$defs/utc"
          },
          "reviewBy": {
            "$ref": "#/$defs/utc"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    }
  }
}
