{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff Check content-aware handoff v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "task",
    "scope",
    "capturedAt",
    "activeConstraints"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "task": { "type": "string", "pattern": "\\S" },
    "scope": { "$ref": "#/$defs/id" },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "activeConstraints": {
      "type": "array",
      "description": "IDs must be unique; enforced by the CLI.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "contentHash"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    }
  }
}
