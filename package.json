{
  "name": "@larusajs/handoff-check",
  "version": "0.1.0",
  "description": "A deterministic, local CLI that verifies active constraints before a coding agent resumes work.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Larusajs/Handoff-Check.git"
  },
  "bin": {
    "handoff-check": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "bun build src/cli.ts --target node --outdir dist",
    "check": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
